---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Picture Grid (픽그) - 원클릭 소셜미디어 사진 그리드 생성기">
  <div class="app-container">
    <!-- Header -->
    <header class="header">
      <div class="brand">
        <div class="logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="8" height="8" rx="2" fill="url(#logo-grad-1)"/>
            <rect x="13" y="3" width="8" height="8" rx="2" fill="url(#logo-grad-2)" opacity="0.8"/>
            <rect x="3" y="13" width="8" height="8" rx="2" fill="url(#logo-grad-2)" opacity="0.8"/>
            <rect x="13" y="13" width="8" height="8" rx="2" fill="url(#logo-grad-1)"/>
            <defs>
              <linearGradient id="logo-grad-1" x1="3" y1="3" x2="11" y2="11" gradientUnits="userSpaceOnUse">
                <stop stop-color="#6366F1"/>
                <stop stop-color="#EC4899"/>
              </linearGradient>
              <linearGradient id="logo-grad-2" x1="13" y1="3" x2="21" y2="11" gradientUnits="userSpaceOnUse">
                <stop stop-color="#A855F7"/>
                <stop stop-color="#6366F1"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="brand-text">
          <h1>PicGrid <span class="gradient-text">픽그</span></h1>
          <p class="subtitle">소셜미디어 사진 그리드 & 레이아웃 원클릭 생성기</p>
        </div>
      </div>
    </header>

    <!-- Main Workspace Grid -->
    <main class="workspace">
      <!-- Control Sidebar -->
      <aside class="sidebar glass-panel">
        
        <!-- Tab 1: Layout Selection -->
        <section class="control-section">
          <h3><span class="step-num">1</span> 그리드 레이아웃 선택</h3>
          <div class="layout-presets" id="layoutPresets">
            <button class="layout-btn active" data-layout="overlay" title="2장 겹침 (오버레이)">
              <div class="layout-icon icon-overlay"></div>
              <span>2장 겹침</span>
            </button>
            <button class="layout-btn" data-layout="grid4" title="4개 그리드 (2x2)">
              <div class="layout-icon icon-grid4"></div>
              <span>4개 그리드</span>
            </button>
            <button class="layout-btn" data-layout="vert10" title="10개 세로 스트립">
              <div class="layout-icon icon-vert10"></div>
              <span>10개 세로</span>
            </button>
            <button class="layout-btn" data-layout="horiz3" title="3개 가로 그리드">
              <div class="layout-icon icon-horiz3"></div>
              <span>3개 가로</span>
            </button>
            <button class="layout-btn" data-layout="polaroid" title="폴라로이드 프레임">
              <div class="layout-icon icon-polaroid"></div>
              <span>폴라로이드</span>
            </button>
            <button class="layout-btn" data-layout="blurSingle" title="블러 배경 모드">
              <div class="layout-icon icon-blurSingle"></div>
              <span>블러 배경</span>
            </button>
          </div>
        </section>

        <!-- Tab 2: Image Upload & Slot Management -->
        <section class="control-section">
          <div class="section-header-flex">
            <h3><span class="step-num">2</span> 사진 업로드</h3>
            <button id="btnLoadSamples" class="btn-text-action">✨ 샘플 불러오기</button>
          </div>
          
          <div class="upload-dropzone" id="dropzone">
            <input type="file" id="fileInput" multiple accept="image/*" class="file-input-hidden" />
            <div class="dropzone-content">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <p>사진 드래그 또는 클릭 업로드</p>
              <span class="help-text">PNG, JPG, WEBP 다중 지원</span>
            </div>
          </div>

          <!-- Image Thumbnails Slot Bar -->
          <div class="slots-container" id="slotsContainer">
            <!-- Dynamic Slots rendered by JS -->
          </div>
        </section>

        <!-- Tab 3: Style Adjustments -->
        <section class="control-section">
          <h3><span class="step-num">3</span> 커스텀 디자인 설정</h3>
          
          <div class="control-group">
            <label>화면 비율</label>
            <div class="ratio-options" id="ratioOptions">
              <button class="chip-btn active" data-ratio="1:1">1:1 (정사각)</button>
              <button class="chip-btn" data-ratio="4:5">4:5 (피드)</button>
              <button class="chip-btn" data-ratio="9:16">9:16 (스토리)</button>
              <button class="chip-btn" data-ratio="16:9">16:9 (와이드)</button>
            </div>
          </div>

          <div class="sliders-grid">
            <div class="control-group">
              <div class="slider-header">
                <label>여백</label>
                <span class="val-display" id="gapVal">20px</span>
              </div>
              <input type="range" id="gapRange" min="0" max="60" value="20" />
            </div>

            <div class="control-group">
              <div class="slider-header">
                <label>모서리 둥글기</label>
                <span class="val-display" id="radiusVal">16px</span>
              </div>
              <input type="range" id="radiusRange" min="0" max="50" value="16" />
            </div>
          </div>

          <div class="control-group">
            <div class="slider-header">
              <label>그림자 강도</label>
              <span class="val-display" id="shadowVal">40%</span>
            </div>
            <input type="range" id="shadowRange" min="0" max="100" value="40" />
          </div>

          <div class="control-group">
            <label>배경 스타일</label>
            <div class="bg-style-picker">
              <label class="bg-option">
                <input type="radio" name="bgType" value="color" checked />
                <span>단색</span>
                <input type="color" id="bgColorPicker" value="#0f172a" />
              </label>
              <label class="bg-option">
                <input type="radio" name="bgType" value="gradient" />
                <span>그라디언트</span>
              </label>
              <label class="bg-option">
                <input type="radio" name="bgType" value="blur" />
                <span>블러</span>
              </label>
            </div>
          </div>

          <div class="control-group">
            <label>사진 필터</label>
            <select id="filterSelect" class="styled-select">
              <option value="none">원본 (None)</option>
              <optgroup label="🎞️ 아날로그 필름 효과 (노이즈+비네팅)">
                <option value="kodak">🎞️ 코닥 웜 골드 (Kodak 35mm)</option>
                <option value="fuji">🎞️ 후지 클래식 (Fuji Chrome)</option>
                <option value="vintage">🎞️ 빈티지 80s (Vintage Film)</option>
                <option value="noir">🎞️ 필름 누아르 (B&W Tri-X)</option>
                <option value="cinematic">🎞️ 시네마틱 틸&오렌지 (Cinematic)</option>
              </optgroup>
              <optgroup label="🎨 일반 감성 필터">
                <option value="warm">감성 워머 (Warm Vintage)</option>
                <option value="cool">쿨 사이버 (Cool Blue)</option>
                <option value="bw">클래식 흑백 (Monochrome)</option>
                <option value="vivid">비비드 팝 (High Contrast)</option>
                <option value="soft">파스텔 소프트 (Soft Glow)</option>
              </optgroup>
            </select>
          </div>

          <div class="control-group">
            <label class="checkbox-container">
              <input type="checkbox" id="dateStampCheckbox" />
              <span class="checkbox-label">📅 필름 카메라 날짜 스탬프 ('26 09 04)</span>
            </label>
          </div>

          <div class="control-group">
            <label>워터마크 / 서명 텍스트</label>
            <input type="text" id="watermarkInput" placeholder="예: @my_instagram" class="styled-input" />
          </div>
        </section>
      </aside>

      <!-- Preview Canvas Stage -->
      <section class="stage-container">
        <div class="stage-toolbar glass-panel">
          <div class="toolbar-left">
            <span class="stage-title">📷 라이브 프리뷰</span>
            <span class="canvas-info" id="canvasSizeInfo">1080 x 1080px</span>
          </div>
          <div class="toolbar-right">
            <button id="btnShuffle" class="btn-secondary" title="사진 위치 무작위 섞기">
              <span>🎲 섞기</span>
            </button>
            <button id="btnReset" class="btn-secondary" title="설정 초기화">
              <span>🔄 초기화</span>
            </button>
            <button id="btnDownload" class="btn-primary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>고화질 다운로드</span>
            </button>
          </div>
        </div>

        <!-- Interactive Canvas Viewport -->
        <div class="canvas-viewport glass-panel" id="viewport">
          <canvas id="mainCanvas"></canvas>
          <div id="canvasLoader" class="canvas-loader hidden">
            <div class="spinner"></div>
            <p>고화질 렌더링 중...</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .app-container {
    height: 100vh;
    max-height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 10px;
    max-width: 1720px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Header Styles */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 18px;
    min-height: 48px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-icon {
    width: 34px;
    height: 34px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-icon svg {
    width: 20px;
    height: 20px;
  }

  .brand-text h1 {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  /* Workspace Layout (Left: Config, Right: Preview) */
  .workspace {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 370px 1fr;
    gap: 12px;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .app-container {
      height: auto;
      overflow: auto;
    }
    .workspace {
      grid-template-columns: 1fr;
    }
  }

  /* Sidebar Controls */
  .sidebar {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: var(--radius-md);
    scrollbar-width: thin;
  }

  .control-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 10px;
  }
  .control-section:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .control-section h3 {
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-main);
  }

  .step-num {
    background: var(--accent-gradient);
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-text-action {
    background: none;
    border: none;
    color: var(--accent-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .btn-text-action:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Compact 3-Column Layout Presets */
  .layout-presets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .layout-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 500;
    transition: all 0.18s ease;
  }
  .layout-btn span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .layout-btn:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: var(--accent-purple);
    color: var(--text-main);
  }
  .layout-btn:hover .layout-icon {
    border-color: var(--accent-purple);
  }
  .layout-btn.active {
    background: rgba(99, 102, 241, 0.15);
    border-color: var(--accent-purple);
    color: #fff;
    box-shadow: 0 0 12px rgba(139, 92, 246, 0.25);
  }

  /* Layout Icons */
  .layout-icon {
    width: 32px;
    height: 24px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    position: relative;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    transition: border-color 0.2s ease;
  }

  .icon-overlay::before {
    content: ''; position: absolute; inset: 3px; background: rgba(99, 102, 241, 0.4); border-radius: 2px;
  }
  .icon-overlay::after {
    content: ''; position: absolute; width: 16px; height: 13px; top: 6px; left: 8px; background: #ec4899; border-radius: 2px; border: 1px solid #fff;
  }

  .icon-grid4 {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px; padding: 3px;
  }
  .icon-grid4::before, .icon-grid4::after {
    content: ''; background: rgba(99, 102, 241, 0.6); border-radius: 1px;
  }

  .icon-vert10 {
    display: flex; gap: 1px; padding: 3px; overflow: hidden;
  }
  .icon-vert10::before {
    content: '';
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      90deg,
      #6366f1 0px,
      #6366f1 2px,
      #a855f7 2px,
      #a855f7 4px,
      #ec4899 4px,
      #ec4899 6px,
      #06b6d4 6px,
      #06b6d4 8px
    );
    border-radius: 1px;
  }

  .icon-horiz3 {
    display: flex; flex-direction: column; gap: 1.5px; padding: 3px;
  }
  .icon-horiz3::before {
    content: '';
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      180deg,
      #8b5cf6 0px,
      #8b5cf6 4px,
      transparent 4px,
      transparent 6px
    );
    border-radius: 1px;
  }

  .icon-polaroid {
    padding: 2px 2px 5px 2px; background: #fff; border-radius: 2px;
  }
  .icon-polaroid::before {
    content: ''; display: block; width: 100%; height: 100%; background: #6366f1; border-radius: 1px;
  }

  .icon-blurSingle {
    background: radial-gradient(circle, #ec4899 0%, #0f172a 100%);
  }
  .icon-blurSingle::after {
    content: ''; position: absolute; inset: 4px; background: #6366f1; border-radius: 2px;
  }

  /* Dropzone */
  .upload-dropzone {
    border: 1.5px dashed rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    text-align: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s ease;
    position: relative;
  }
  .upload-dropzone:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: var(--accent-purple);
    box-shadow: 0 0 16px rgba(139, 92, 246, 0.15);
  }
  .upload-dropzone:hover .dropzone-content svg {
    color: var(--accent-purple);
    stroke: var(--accent-purple);
    transform: translateY(-1px);
  }
  .file-input-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: var(--text-muted);
  }
  .dropzone-content svg {
    color: var(--text-dim);
    transition: all 0.2s ease;
  }
  .dropzone-content p {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .help-text {
    font-size: 0.68rem;
    color: var(--text-dim);
  }

  /* Slot Thumbnails Bar */
  .slots-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px 0 2px 0;
    max-height: 115px;
    overflow-y: auto;
  }

  /* Controls Styling */
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .control-group label {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .sliders-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .val-display {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .ratio-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .chip-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    padding: 5px 2px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    transition: all 0.18s ease;
  }
  .chip-btn:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: var(--accent-purple);
    color: #fff;
  }
  .chip-btn.active {
    background: rgba(139, 92, 246, 0.25);
    color: #fff;
    border-color: var(--accent-purple);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.25);
  }

  .bg-style-picker {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .bg-option {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.76rem;
    cursor: pointer;
  }
  .bg-option input[type="radio"] {
    cursor: pointer;
    accent-color: #8b5cf6;
  }
  .bg-option input[type="color"] {
    width: 22px;
    height: 22px;
  }

  .styled-select, .styled-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-main);
    padding: 7px 10px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.78rem;
    outline: none;
    color-scheme: dark;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .styled-select:hover, .styled-input:hover {
    border-color: rgba(139, 92, 246, 0.6);
  }
  .styled-select:focus, .styled-input:focus {
    border-color: var(--accent-purple);
    box-shadow: 0 0 8px rgba(139, 92, 246, 0.25);
  }
  .styled-select optgroup {
    background-color: #1e1b4b;
    color: #38bdf8;
    font-weight: 700;
    font-style: normal;
    padding: 4px;
  }
  .styled-select option {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 4px 8px;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.03);
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }
  .checkbox-container:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.3);
  }
  .checkbox-container input[type="checkbox"] {
    cursor: pointer;
    accent-color: #f59e0b;
    width: 15px;
    height: 15px;
  }
  .checkbox-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  /* Sidebar Mini Footer */
  .sidebar-mini-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--text-dim);
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: auto;
  }

  /* Stage Workspace (Right: Preview) */
  .stage-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    min-height: 0;
  }

  .stage-toolbar {
    padding: 8px 16px;
    min-height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stage-title {
    font-weight: 700;
    font-size: 0.88rem;
  }
  .canvas-info {
    font-size: 0.72rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .toolbar-right {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .toolbar-right .btn-secondary {
    padding: 6px 12px;
    font-size: 0.78rem;
    border-radius: 8px;
  }
  .toolbar-right .btn-primary {
    padding: 7px 16px;
    font-size: 0.8rem;
    border-radius: 8px;
  }

  .canvas-viewport {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.75) 100%);
  }

  canvas {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);
    transition: transform 0.2s ease;
  }

  .canvas-loader {
    position: absolute;
    inset: 0;
    background: rgba(9, 10, 15, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    z-index: 10;
  }
  .canvas-loader.hidden {
    display: none;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-left-color: #6366f1;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  // Client-side Canvas Logic for Picture Grid (픽그)
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const canvasSizeInfo = document.getElementById('canvasSizeInfo')!;
    
    // State variables
    let currentLayout = 'overlay';
    let currentRatio = '1:1';
    let images: HTMLImageElement[] = [];
    let gap = 20;
    let radius = 16;
    let shadowIntensity = 40;
    let bgType = 'color';
    let bgColor = '#0f172a';
    let currentFilter = 'none';
    let showDateStamp = false;
    let watermarkText = '';

    // Sample Images
    const sampleImageUrls = [
      '/samples/sample1.jpg',
      '/samples/sample2.jpg'
    ];

    // Film grain pattern generator (cached canvas pattern for performance)
    let grainPattern: CanvasPattern | null = null;
    function getGrainPattern(): CanvasPattern | null {
      if (grainPattern) return grainPattern;
      const pCanvas = document.createElement('canvas');
      pCanvas.width = 160;
      pCanvas.height = 160;
      const pCtx = pCanvas.getContext('2d');
      if (!pCtx) return null;
      const imgData = pCtx.createImageData(160, 160);
      const data = imgData.data;
      for (let i = 0; i < data.length; i += 4) {
        // High-contrast authentic film grain grain particles (Silver Halide effect)
        const isDark = Math.random() < 0.5;
        const val = isDark ? Math.floor(Math.random() * 80) : Math.floor(175 + Math.random() * 80);
        data[i] = val;
        data[i + 1] = val;
        data[i + 2] = val;
        data[i + 3] = 58; // Enhanced grain opacity for visible organic film texture
      }
      pCtx.putImageData(imgData, 0, 0);
      grainPattern = ctx.createPattern(pCanvas, 'repeat');
      return grainPattern;
    }

    function isFilmFilter(filter: string): boolean {
      return ['kodak', 'fuji', 'vintage', 'noir', 'cinematic'].includes(filter);
    }

    // Initialize Canvas Dimensions based on Aspect Ratio
    function getCanvasDimensions() {
      const baseWidth = 1080;
      switch (currentRatio) {
        case '4:5': return { width: 1080, height: 1350 };
        case '9:16': return { width: 1080, height: 1920 };
        case '16:9': return { width: 1920, height: 1080 };
        case '1:1': default: return { width: 1080, height: 1080 };
      }
    }

    // Load initial sample images
    async function loadSamples() {
      images = [];
      const promises = sampleImageUrls.map(url => {
        return new Promise<HTMLImageElement>((resolve) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => resolve(img);
          img.src = url;
        });
      });
      images = await Promise.all(promises);
      renderSlots();
      drawCanvas();
    }

    // Render uploaded slot thumbnails
    function renderSlots() {
      const container = document.getElementById('slotsContainer')!;
      container.innerHTML = '';
      images.forEach((img, idx) => {
        const thumb = document.createElement('img');
        thumb.src = img.src;
        thumb.className = 'slot-thumb';
        thumb.title = `사진 #${idx + 1}`;
        container.appendChild(thumb);
      });
    }

    // Helper: Draw rounded rectangle path
    function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      if (w < 2 * r) r = w / 2;
      if (h < 2 * r) r = h / 2;
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // Helper: Cover-fit image inside rectangle
    function drawImageCover(ctx: CanvasRenderingContext2D, img: HTMLImageElement, x: number, y: number, w: number, h: number, r: number) {
      ctx.save();
      roundRect(ctx, x, y, w, h, r);
      ctx.clip();

      const imgRatio = img.width / img.height;
      const rectRatio = w / h;
      let nw = w, nh = h;
      let nx = x, ny = y;

      if (imgRatio > rectRatio) {
        nw = h * imgRatio;
        nx = x - (nw - w) / 2;
      } else {
        nh = w / imgRatio;
        ny = y - (nh - h) / 2;
      }

      // 1. Apply Filter and Draw Image
      applyCanvasFilter(ctx);
      ctx.drawImage(img, nx, ny, nw, nh);
      ctx.filter = 'none';

      // 2. Apply Film Effects (Vignette & Grain) if film filter is selected
      if (isFilmFilter(currentFilter)) {
        // Classic Vignetting
        const radiusDist = Math.max(w, h) * 0.72;
        const vignette = ctx.createRadialGradient(
          x + w / 2, y + h / 2, Math.min(w, h) * 0.28,
          x + w / 2, y + h / 2, radiusDist
        );
        vignette.addColorStop(0, 'rgba(0, 0, 0, 0)');
        vignette.addColorStop(0.7, 'rgba(0, 0, 0, 0.12)');
        vignette.addColorStop(1, currentFilter === 'noir' ? 'rgba(0, 0, 0, 0.45)' : 'rgba(35, 18, 5, 0.32)');

        ctx.fillStyle = vignette;
        ctx.fillRect(x, y, w, h);

        // Film Grain Texture (Overlay blend)
        const pattern = getGrainPattern();
        if (pattern) {
          ctx.save();
          ctx.globalCompositeOperation = 'overlay';
          ctx.fillStyle = pattern;
          ctx.fillRect(x, y, w, h);
          ctx.restore();
        }
      }

      // 3. Vintage Film Date Stamp Overlay ('26 09 04)
      if (showDateStamp) {
        ctx.save();
        const fontSize = Math.max(14, Math.round(w * 0.04));
        ctx.font = `bold ${fontSize}px "Courier New", monospace`;
        ctx.textAlign = 'right';
        ctx.textBaseline = 'bottom';
        // 82% 투명도로 배경 사진과 자연스럽게 블렌딩되는 아날로그 필름 LED 감광 효과
        ctx.fillStyle = 'rgba(255, 131, 0, 0.82)';
        
        // 진한 그림자 및 오프셋 제거: 있는 듯 없는 듯 아른아른한 초미세 아날로그 발광만 적용
        ctx.shadowOffsetX = 0;
        ctx.shadowOffsetY = 0;
        ctx.shadowColor = 'rgba(255, 120, 0, 0.18)';
        ctx.shadowBlur = 1.5;
        
        const today = new Date();
        const yy = String(today.getFullYear()).slice(-2);
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        const dateStr = `'${yy} ${mm} ${dd}`;

        ctx.fillText(dateStr, x + w - Math.max(12, w * 0.035), y + h - Math.max(10, h * 0.03));
        ctx.restore();
      }

      ctx.restore();
    }

    // Filter Switcher
    function applyCanvasFilter(ctx: CanvasRenderingContext2D) {
      switch (currentFilter) {
        // Film Presets
        case 'kodak':
          ctx.filter = 'sepia(0.32) contrast(1.15) brightness(1.03) saturate(1.25) hue-rotate(-5deg)';
          break;
        case 'fuji':
          ctx.filter = 'sepia(0.18) contrast(1.18) brightness(1.02) saturate(0.95) hue-rotate(15deg)';
          break;
        case 'vintage':
          ctx.filter = 'sepia(0.46) contrast(0.95) brightness(1.06) saturate(0.85) hue-rotate(-10deg)';
          break;
        case 'noir':
          ctx.filter = 'grayscale(1) contrast(1.45) brightness(0.92)';
          break;
        case 'cinematic':
          ctx.filter = 'contrast(1.22) saturate(1.32) hue-rotate(-15deg) brightness(0.96)';
          break;
        // Standard Presets
        case 'warm':
          ctx.filter = 'sepia(0.25) saturate(1.2) contrast(1.05)';
          break;
        case 'cool':
          ctx.filter = 'hue-rotate(180deg) saturate(1.1) brightness(1.02)';
          break;
        case 'bw':
          ctx.filter = 'grayscale(1) contrast(1.15)';
          break;
        case 'vivid':
          ctx.filter = 'saturate(1.6) contrast(1.2)';
          break;
        case 'soft':
          ctx.filter = 'brightness(1.08) contrast(0.92) saturate(1.1)';
          break;
        case 'none': default:
          ctx.filter = 'none';
          break;
      }
    }

    // Main Draw Function
    function drawCanvas() {
      const dims = getCanvasDimensions();
      canvas.width = dims.width;
      canvas.height = dims.height;
      canvasSizeInfo.textContent = `${dims.width} x ${dims.height}px`;

      // 1. Draw Background
      if (bgType === 'color') {
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, dims.width, dims.height);
      } else if (bgType === 'gradient') {
        const grad = ctx.createLinearGradient(0, 0, dims.width, dims.height);
        grad.addColorStop(0, '#0f172a');
        grad.addColorStop(0.5, '#1e1b4b');
        grad.addColorStop(1, '#31103f');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, dims.width, dims.height);
      } else if (bgType === 'blur' && images.length > 0) {
        ctx.save();
        ctx.filter = 'blur(40px) brightness(0.6)';
        ctx.drawImage(images[0], -50, -50, dims.width + 100, dims.height + 100);
        ctx.restore();
      }

      if (images.length === 0) return;

      // Set Shadow
      if (shadowIntensity > 0) {
        ctx.shadowColor = 'rgba(0, 0, 0, ' + (shadowIntensity / 100) + ')';
        ctx.shadowBlur = shadowIntensity * 0.5;
        ctx.shadowOffsetY = shadowIntensity * 0.3;
      } else {
        ctx.shadowColor = 'transparent';
      }

      // 2. Render Selected Layout
      const pad = gap;
      const r = radius;

      if (currentLayout === 'overlay') {
        // Layout 1: 2 Photos Overlaid (Background + Centered Foreground Overlay)
        const bgImg = images[0];
        const fgImg = images[1] || images[0];

        // Background Image
        drawImageCover(ctx, bgImg, pad, pad, dims.width - pad * 2, dims.height - pad * 2, r);

        // Overlay Centered Image (65% size)
        const overlayW = (dims.width - pad * 2) * 0.65;
        const overlayH = (dims.height - pad * 2) * 0.65;
        const overlayX = (dims.width - overlayW) / 2;
        const overlayY = (dims.height - overlayH) / 2;

        ctx.shadowColor = 'rgba(0, 0, 0, ' + (shadowIntensity / 70) + ')';
        ctx.shadowBlur = shadowIntensity * 0.8;
        drawImageCover(ctx, fgImg, overlayX, overlayY, overlayW, overlayH, r);
      } 
      else if (currentLayout === 'grid4') {
        // Layout 2: 4 Grid (2x2)
        const cellW = (dims.width - pad * 3) / 2;
        const cellH = (dims.height - pad * 3) / 2;

        const positions = [
          { x: pad, y: pad },
          { x: pad * 2 + cellW, y: pad },
          { x: pad, y: pad * 2 + cellH },
          { x: pad * 2 + cellW, y: pad * 2 + cellH }
        ];

        positions.forEach((pos, idx) => {
          const img = images[idx % images.length];
          drawImageCover(ctx, img, pos.x, pos.y, cellW, cellH, r);
        });
      }
      else if (currentLayout === 'vert10') {
        // Layout 3: 10 Vertical Strips (10 columns side-by-side in 1 row)
        const cols = 10;
        const totalW = dims.width - pad * 2;
        const totalH = dims.height - pad * 2;
        const startX = pad;
        const startY = pad;

        // Draw shadow base for the card
        if (shadowIntensity > 0) {
          ctx.save();
          ctx.fillStyle = '#0f172a';
          roundRect(ctx, startX, startY, totalW, totalH, r);
          ctx.fill();
          ctx.restore();
        }

        // Clip the entire card with rounded corners
        ctx.save();
        if (r > 0) {
          roundRect(ctx, startX, startY, totalW, totalH, r);
          ctx.clip();
        }

        for (let i = 0; i < cols; i++) {
          const x1 = startX + (i * totalW) / cols;
          const x2 = startX + ((i + 1) * totalW) / cols;
          const stripW = x2 - x1;
          const img = images[i % images.length];
          drawImageCover(ctx, img, x1, startY, stripW + 0.5, totalH, 0);
        }
        ctx.restore();
      }
      else if (currentLayout === 'horiz3') {
        // Layout 4: 3 Horizontal Grid Stack
        const rows = 3;
        const cellW = dims.width - pad * 2;
        const cellH = (dims.height - pad * 4) / rows;

        for (let i = 0; i < 3; i++) {
          const y = pad + i * (cellH + pad);
          const img = images[i % images.length];
          drawImageCover(ctx, img, pad, y, cellW, cellH, r);
        }
      }
      else if (currentLayout === 'polaroid') {
        // Layout 5: Polaroid Frame Style
        const frameW = dims.width - pad * 4;
        const frameH = dims.height - pad * 4;
        const frameX = pad * 2;
        const frameY = pad * 2;

        // White Frame Background
        ctx.save();
        ctx.fillStyle = '#ffffff';
        roundRect(ctx, frameX, frameY, frameW, frameH, r + 4);
        ctx.fill();
        ctx.restore();

        // Inner Photo
        const photoPad = 24;
        const photoW = frameW - photoPad * 2;
        const photoH = frameH - photoPad * 2 - 80; // Extra bottom space for polaroid caption
        drawImageCover(ctx, images[0], frameX + photoPad, frameY + photoPad, photoW, photoH, Math.max(0, r - 4));
      }
      else if (currentLayout === 'blurSingle') {
        // Layout 6: Single Focus with Blur BG
        const cellW = dims.width - pad * 4;
        const cellH = dims.height - pad * 4;
        drawImageCover(ctx, images[0], pad * 2, pad * 2, cellW, cellH, r);
      }

      // 3. Render Watermark Text if specified
      if (watermarkText.trim()) {
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.8)';
        ctx.shadowBlur = 6;
        ctx.fillStyle = '#ffffff';
        ctx.font = '600 24px Outfit, sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText(watermarkText, dims.width - pad - 20, dims.height - pad - 20);
        ctx.restore();
      }
    }

    // Event Listeners
    document.querySelectorAll('#layoutPresets .layout-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('#layoutPresets .layout-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentLayout = target.getAttribute('data-layout')!;
        drawCanvas();
      });
    });

    document.querySelectorAll('#ratioOptions .chip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('#ratioOptions .chip-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRatio = target.getAttribute('data-ratio')!;
        drawCanvas();
      });
    });

    // File Upload Handler
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (!files || files.length === 0) return;

      const loadedImgs: HTMLImageElement[] = [];
      let count = 0;
      for (let i = 0; i < files.length; i++) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            loadedImgs.push(img);
            count++;
            if (count === files.length) {
              images = loadedImgs;
              renderSlots();
              drawCanvas();
            }
          };
          img.src = event.target!.result as string;
        };
        reader.readAsDataURL(files[i]);
      }
    });

    // Sample Load Button
    document.getElementById('btnLoadSamples')!.addEventListener('click', loadSamples);

    // Range Controls
    const gapRange = document.getElementById('gapRange') as HTMLInputElement;
    gapRange.addEventListener('input', (e) => {
      gap = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('gapVal')!.textContent = `${gap}px`;
      drawCanvas();
    });

    const radiusRange = document.getElementById('radiusRange') as HTMLInputElement;
    radiusRange.addEventListener('input', (e) => {
      radius = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('radiusVal')!.textContent = `${radius}px`;
      drawCanvas();
    });

    const shadowRange = document.getElementById('shadowRange') as HTMLInputElement;
    shadowRange.addEventListener('input', (e) => {
      shadowIntensity = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('shadowVal')!.textContent = `${shadowIntensity}%`;
      drawCanvas();
    });

    // Background type
    document.querySelectorAll('input[name="bgType"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        bgType = (e.target as HTMLInputElement).value;
        drawCanvas();
      });
    });

    const bgColorPicker = document.getElementById('bgColorPicker') as HTMLInputElement;
    bgColorPicker.addEventListener('input', (e) => {
      bgColor = (e.target as HTMLInputElement).value;
      bgType = 'color';
      drawCanvas();
    });

    // Filter
    const filterSelect = document.getElementById('filterSelect') as HTMLSelectElement;
    filterSelect.addEventListener('change', (e) => {
      currentFilter = (e.target as HTMLSelectElement).value;
      drawCanvas();
    });

    // Film Date Stamp Checkbox
    const dateStampCheckbox = document.getElementById('dateStampCheckbox') as HTMLInputElement;
    dateStampCheckbox.addEventListener('change', (e) => {
      showDateStamp = (e.target as HTMLInputElement).checked;
      drawCanvas();
    });

    // Watermark
    const watermarkInput = document.getElementById('watermarkInput') as HTMLInputElement;
    watermarkInput.addEventListener('input', (e) => {
      watermarkText = (e.target as HTMLInputElement).value;
      drawCanvas();
    });

    // Actions
    document.getElementById('btnShuffle')!.addEventListener('click', () => {
      images.sort(() => Math.random() - 0.5);
      renderSlots();
      drawCanvas();
    });

    document.getElementById('btnReset')!.addEventListener('click', () => {
      gap = 20; radius = 16; shadowIntensity = 40;
      gapRange.value = '20'; document.getElementById('gapVal')!.textContent = '20px';
      radiusRange.value = '16'; document.getElementById('radiusVal')!.textContent = '16px';
      shadowRange.value = '40'; document.getElementById('shadowVal')!.textContent = '40%';
      currentFilter = 'none'; filterSelect.value = 'none';
      showDateStamp = false; dateStampCheckbox.checked = false;
      watermarkText = ''; watermarkInput.value = '';
      drawCanvas();
    });

    // One-Click HD Download
    document.getElementById('btnDownload')!.addEventListener('click', () => {
      const loader = document.getElementById('canvasLoader')!;
      loader.classList.remove('hidden');
      setTimeout(() => {
        const link = document.createElement('a');
        link.download = `PicGrid_${currentLayout}_${Date.now()}.png`;
        link.href = canvas.toDataURL('image/png', 1.0);
        link.click();
        loader.classList.add('hidden');
      }, 300);
    });

    // Initial Load
    loadSamples();
  });
</script>
