---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Picture Grid (픽그) - 원클릭 소셜미디어 사진 그리드 생성기">
  <div class="app-container">
    <!-- Header -->
    <header class="header">
      <div class="brand">
        <div class="logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="8" height="8" rx="2" fill="url(#logo-grad-1)"/>
            <rect x="13" y="3" width="8" height="8" rx="2" fill="url(#logo-grad-2)" opacity="0.8"/>
            <rect x="3" y="13" width="8" height="8" rx="2" fill="url(#logo-grad-2)" opacity="0.8"/>
            <rect x="13" y="13" width="8" height="8" rx="2" fill="url(#logo-grad-1)"/>
            <defs>
              <linearGradient id="logo-grad-1" x1="3" y1="3" x2="11" y2="11" gradientUnits="userSpaceOnUse">
                <stop stop-color="#6366F1"/>
                <stop stop-color="#EC4899"/>
              </linearGradient>
              <linearGradient id="logo-grad-2" x1="13" y1="3" x2="21" y2="11" gradientUnits="userSpaceOnUse">
                <stop stop-color="#A855F7"/>
                <stop stop-color="#6366F1"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="brand-text">
          <h1>PicGrid <span class="gradient-text">픽그</span></h1>
          <p class="subtitle">소셜미디어 사진 그리드 & 레이아웃 원클릭 생성기</p>
        </div>
      </div>
      <div class="header-badges">
        <span class="badge-free">⚡ 100% FREE</span>
        <span class="badge-secure">🔒 100% 브라우저 연산 (서버 저장 없음)</span>
      </div>
    </header>

    <!-- Main Workspace Grid -->
    <main class="workspace">
      <!-- Control Sidebar -->
      <aside class="sidebar glass-panel">
        
        <!-- Tab 1: Layout Selection -->
        <section class="control-section">
          <h3><span class="step-num">1</span> 그리드 레이아웃 선택</h3>
          <div class="layout-presets" id="layoutPresets">
            <button class="layout-btn active" data-layout="overlay">
              <div class="layout-icon icon-overlay"></div>
              <span>2장 겹침 (오버레이)</span>
            </button>
            <button class="layout-btn" data-layout="grid4">
              <div class="layout-icon icon-grid4"></div>
              <span>4개 그리드 (2x2)</span>
            </button>
            <button class="layout-btn" data-layout="vert10">
              <div class="layout-icon icon-vert10"></div>
              <span>10개 세로 스트립</span>
            </button>
            <button class="layout-btn" data-layout="horiz3">
              <div class="layout-icon icon-horiz3"></div>
              <span>3개 가로 그리드</span>
            </button>
            <button class="layout-btn" data-layout="polaroid">
              <div class="layout-icon icon-polaroid"></div>
              <span>폴라로이드 프레임</span>
            </button>
            <button class="layout-btn" data-layout="blurSingle">
              <div class="layout-icon icon-blurSingle"></div>
              <span>블러 배경 모드</span>
            </button>
          </div>
        </section>

        <!-- Tab 2: Image Upload & Slot Management -->
        <section class="control-section">
          <div class="section-header-flex">
            <h3><span class="step-num">2</span> 사진 업로드</h3>
            <button id="btnLoadSamples" class="btn-text-action">✨ 샘플 사진 불러오기</button>
          </div>
          
          <div class="upload-dropzone" id="dropzone">
            <input type="file" id="fileInput" multiple accept="image/*" class="file-input-hidden" />
            <div class="dropzone-content">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <p>사진들을 여기로 드래그하거나 클릭하세요</p>
              <span class="help-text">여러 장 한 번에 업로드 가능 (PNG, JPG, WEBP)</span>
            </div>
          </div>

          <!-- Image Thumbnails Slot Bar -->
          <div class="slots-container" id="slotsContainer">
            <!-- Dynamic Slots rendered by JS -->
          </div>
        </section>

        <!-- Tab 3: Style Adjustments -->
        <section class="control-section">
          <h3><span class="step-num">3</span> 커스텀 디자인 설정</h3>
          
          <div class="control-group">
            <label>화면 비율 (Aspect Ratio)</label>
            <div class="ratio-options" id="ratioOptions">
              <button class="chip-btn active" data-ratio="1:1">1:1 (정사각형)</button>
              <button class="chip-btn" data-ratio="4:5">4:5 (인스타 피드)</button>
              <button class="chip-btn" data-ratio="9:16">9:16 (스토리/릴스)</button>
              <button class="chip-btn" data-ratio="16:9">16:9 (가로형)</button>
            </div>
          </div>

          <div class="control-group">
            <div class="slider-header">
              <label>여백 (Padding / Gap)</label>
              <span class="val-display" id="gapVal">20px</span>
            </div>
            <input type="range" id="gapRange" min="0" max="60" value="20" />
          </div>

          <div class="control-group">
            <div class="slider-header">
              <label>모서리 둥글기 (Border Radius)</label>
              <span class="val-display" id="radiusVal">16px</span>
            </div>
            <input type="range" id="radiusRange" min="0" max="50" value="16" />
          </div>

          <div class="control-group">
            <div class="slider-header">
              <label>그림자 강도 (Shadow)</label>
              <span class="val-display" id="shadowVal">40%</span>
            </div>
            <input type="range" id="shadowRange" min="0" max="100" value="40" />
          </div>

          <div class="control-group">
            <label>배경 스타일</label>
            <div class="bg-style-picker">
              <label class="bg-option">
                <input type="radio" name="bgType" value="color" checked />
                <span>단색</span>
                <input type="color" id="bgColorPicker" value="#0f172a" />
              </label>
              <label class="bg-option">
                <input type="radio" name="bgType" value="gradient" />
                <span>그라디언트</span>
              </label>
              <label class="bg-option">
                <input type="radio" name="bgType" value="blur" />
                <span>배경 블러</span>
              </label>
            </div>
          </div>

          <div class="control-group">
            <label>사진 필터</label>
            <select id="filterSelect" class="styled-select">
              <option value="none">원본 (None)</option>
              <option value="warm">감성 워머 (Warm Vintage)</option>
              <option value="cool">쿨 사이버 (Cool Blue)</option>
              <option value="bw">클래식 흑백 (Monochrome)</option>
              <option value="vivid">비비드 팝 (High Contrast)</option>
              <option value="soft">파스텔 소프트 (Soft Glow)</option>
            </select>
          </div>

          <div class="control-group">
            <label>워터마크 / 텍스트 삽입</label>
            <input type="text" id="watermarkInput" placeholder="예: @my_instagram" class="styled-input" />
          </div>
        </section>

      </aside>

      <!-- Preview Canvas Stage -->
      <section class="stage-container">
        <div class="stage-toolbar glass-panel">
          <div class="toolbar-left">
            <span class="stage-title">📷 라이브 프리뷰</span>
            <span class="canvas-info" id="canvasSizeInfo">1080 x 1080px</span>
          </div>
          <div class="toolbar-right">
            <button id="btnShuffle" class="btn-secondary" title="사진 위치 무작위 섞기">
              <span>🎲 섞기</span>
            </button>
            <button id="btnReset" class="btn-secondary" title="설정 초기화">
              <span>🔄 초기화</span>
            </button>
            <button id="btnDownload" class="btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>고화질 다운로드</span>
            </button>
          </div>
        </div>

        <!-- Interactive Canvas Viewport -->
        <div class="canvas-viewport glass-panel" id="viewport">
          <canvas id="mainCanvas"></canvas>
          <div id="canvasLoader" class="canvas-loader hidden">
            <div class="spinner"></div>
            <p>고화질 렌더링 중...</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Bottom Features & Security Banner -->
    <footer class="footer glass-panel">
      <div class="footer-features">
        <div class="feature-item">
          <div class="feature-icon">🔒</div>
          <div>
            <h4>100% 개인정보 보호</h4>
            <p>모든 사진 연산이 사용자의 웹 브라우저 메모리 안에서만 이루어지며, 외부 서버로 사진이 업로드되지 않습니다.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">⚡</div>
          <div>
            <h4>초고속 원클릭 생성</h4>
            <p>포토샵이나 피그마 레이어 작업 필요 없이 버튼 하나로 인스타그램용 고화질 그리드를 바로 만듭니다.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">💸</div>
          <div>
            <h4>평생 100% 무료</h4>
            <p>워터마크 없는 고화질 이미지(1080p+) 다운로드를 제한 없이 무료로 제공합니다.</p>
          </div>
        </div>
      </div>
      <div class="footer-copy">
        <p>© 2026 Picture Grid (픽그). Developed with Astro & HTML5 Canvas API.</p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .app-container {
    max-width: 1540px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 100vh;
  }

  /* Header Styles */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 28px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text h1 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .header-badges {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .badge-secure {
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 99px;
  }

  /* Workspace Layout */
  .workspace {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 1080px) {
    .workspace {
      grid-template-columns: 1fr;
    }
  }

  /* Sidebar Controls */
  .sidebar {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .control-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 20px;
  }
  .control-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .control-section h3 {
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-main);
  }

  .step-num {
    background: var(--accent-gradient);
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-text-action {
    background: none;
    border: none;
    color: var(--accent-cyan);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .btn-text-action:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Layout Selector Grid */
  .layout-presets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .layout-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .layout-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-main);
  }
  .layout-btn.active {
    background: rgba(99, 102, 241, 0.15);
    border-color: #6366f1;
    color: #fff;
    box-shadow: 0 0 15px rgba(99, 102, 241, 0.25);
  }

  /* Layout Icons Visual Representation */
  .layout-icon {
    width: 44px;
    height: 36px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 6px;
    position: relative;
    border: 1px dashed rgba(255, 255, 255, 0.2);
  }

  .icon-overlay::before {
    content: ''; position: absolute; inset: 4px; background: rgba(99, 102, 241, 0.4); border-radius: 3px;
  }
  .icon-overlay::after {
    content: ''; position: absolute; width: 22px; height: 18px; top: 9px; left: 11px; background: #ec4899; border-radius: 3px; border: 1px solid #fff;
  }

  .icon-grid4 {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px; padding: 4px;
  }
  .icon-grid4::before, .icon-grid4::after {
    content: ''; background: rgba(99, 102, 241, 0.6); border-radius: 2px;
  }

  .icon-vert10 {
    display: flex; flex-direction: column; gap: 2px; padding: 3px; overflow: hidden;
  }
  .icon-vert10::before {
    content: ''; height: 100%; background: linear-gradient(to bottom, #6366f1, #a855f7, #ec4899); border-radius: 2px;
  }

  .icon-horiz3 {
    display: flex; gap: 2px; padding: 4px;
  }
  .icon-horiz3::before {
    content: ''; width: 100%; background: #8b5cf6; border-radius: 2px;
  }

  .icon-polaroid {
    padding: 3px 3px 8px 3px; background: #fff; border-radius: 3px;
  }
  .icon-polaroid::before {
    content: ''; display: block; width: 100%; height: 100%; background: #6366f1; border-radius: 1px;
  }

  .icon-blurSingle {
    background: radial-gradient(circle, #ec4899 0%, #0f172a 100%);
  }
  .icon-blurSingle::after {
    content: ''; position: absolute; inset: 6px; background: #6366f1; border-radius: 3px;
  }

  /* Dropzone */
  .upload-dropzone {
    border: 2px dashed rgba(99, 102, 241, 0.4);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    background: rgba(99, 102, 241, 0.04);
    transition: all 0.2s ease;
    position: relative;
  }
  .upload-dropzone:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: #6366f1;
  }
  .file-input-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }
  .dropzone-content p {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-main);
  }
  .help-text {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  /* Slot Thumbnails Bar */
  .slots-container {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 6px 0;
  }
  .slot-thumb {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    border: 2px solid var(--border-color);
    position: relative;
    flex-shrink: 0;
  }
  .slot-thumb.active {
    border-color: #ec4899;
    box-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
  }

  /* Controls Styling */
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .control-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .val-display {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .ratio-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  .chip-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 8px;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .chip-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .chip-btn.active {
    background: var(--border-active);
    color: #fff;
    border-color: var(--border-active);
  }

  .bg-style-picker {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .bg-option {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .styled-select, .styled-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.85rem;
    outline: none;
  }
  .styled-select:focus, .styled-input:focus {
    border-color: var(--border-active);
  }
  .styled-select option {
    background: #0f172a;
    color: #fff;
  }

  /* Stage Workspace */
  .stage-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
  }

  .stage-toolbar {
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .stage-title {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .canvas-info {
    font-size: 0.75rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .toolbar-right {
    display: flex;
    gap: 10px;
  }

  .canvas-viewport {
    flex: 1;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.5) 0%, rgba(15, 23, 42, 0.8) 100%);
  }

  canvas {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s ease;
  }

  .canvas-loader {
    position: absolute;
    inset: 0;
    background: rgba(9, 10, 15, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 10;
  }
  .canvas-loader.hidden {
    display: none;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(255, 255, 255, 0.1);
    border-left-color: #6366f1;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Footer */
  .footer {
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 10px;
  }
  .footer-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 768px) {
    .footer-features {
      grid-template-columns: 1fr;
    }
  }
  .feature-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .feature-icon {
    font-size: 1.6rem;
    background: rgba(255, 255, 255, 0.05);
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .feature-item h4 {
    font-size: 0.92rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .feature-item p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .footer-copy {
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-dim);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 16px;
  }
</style>

<script>
  // Client-side Canvas Logic for Picture Grid (픽그)
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const canvasSizeInfo = document.getElementById('canvasSizeInfo')!;
    
    // State variables
    let currentLayout = 'overlay';
    let currentRatio = '1:1';
    let images: HTMLImageElement[] = [];
    let gap = 20;
    let radius = 16;
    let shadowIntensity = 40;
    let bgType = 'color';
    let bgColor = '#0f172a';
    let currentFilter = 'none';
    let watermarkText = '';

    // Sample Images
    const sampleImageUrls = [
      '/samples/sample1.jpg',
      '/samples/sample2.jpg'
    ];

    // Initialize Canvas Dimensions based on Aspect Ratio
    function getCanvasDimensions() {
      const baseWidth = 1080;
      switch (currentRatio) {
        case '4:5': return { width: 1080, height: 1350 };
        case '9:16': return { width: 1080, height: 1920 };
        case '16:9': return { width: 1920, height: 1080 };
        case '1:1': default: return { width: 1080, height: 1080 };
      }
    }

    // Load initial sample images
    async function loadSamples() {
      images = [];
      const promises = sampleImageUrls.map(url => {
        return new Promise<HTMLImageElement>((resolve) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => resolve(img);
          img.src = url;
        });
      });
      images = await Promise.all(promises);
      renderSlots();
      drawCanvas();
    }

    // Render uploaded slot thumbnails
    function renderSlots() {
      const container = document.getElementById('slotsContainer')!;
      container.innerHTML = '';
      images.forEach((img, idx) => {
        const thumb = document.createElement('img');
        thumb.src = img.src;
        thumb.className = `slot-thumb ${idx === 0 ? 'active' : ''}`;
        thumb.title = `사진 #${idx + 1}`;
        container.appendChild(thumb);
      });
    }

    // Helper: Draw rounded rectangle path
    function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      if (w < 2 * r) r = w / 2;
      if (h < 2 * r) r = h / 2;
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // Helper: Cover-fit image inside rectangle
    function drawImageCover(ctx: CanvasRenderingContext2D, img: HTMLImageElement, x: number, y: number, w: number, h: number, r: number) {
      ctx.save();
      roundRect(ctx, x, y, w, h, r);
      ctx.clip();

      const imgRatio = img.width / img.height;
      const rectRatio = w / h;
      let nw = w, nh = h;
      let nx = x, ny = y;

      if (imgRatio > rectRatio) {
        nw = h * imgRatio;
        nx = x - (nw - w) / 2;
      } else {
        nh = w / imgRatio;
        ny = y - (nh - h) / 2;
      }

      // Apply Filter
      applyCanvasFilter(ctx);
      ctx.drawImage(img, nx, ny, nw, nh);
      ctx.restore();
    }

    // Filter Switcher
    function applyCanvasFilter(ctx: CanvasRenderingContext2D) {
      switch (currentFilter) {
        case 'warm':
          ctx.filter = 'sepia(0.25) saturate(1.2) contrast(1.05)';
          break;
        case 'cool':
          ctx.filter = 'hue-rotate(180deg) saturate(1.1) brightness(1.02)';
          break;
        case 'bw':
          ctx.filter = 'grayscale(1) contrast(1.15)';
          break;
        case 'vivid':
          ctx.filter = 'saturate(1.6) contrast(1.2)';
          break;
        case 'soft':
          ctx.filter = 'brightness(1.08) contrast(0.92) saturate(1.1)';
          break;
        case 'none': default:
          ctx.filter = 'none';
          break;
      }
    }

    // Main Draw Function
    function drawCanvas() {
      const dims = getCanvasDimensions();
      canvas.width = dims.width;
      canvas.height = dims.height;
      canvasSizeInfo.textContent = `${dims.width} x ${dims.height}px`;

      // 1. Draw Background
      if (bgType === 'color') {
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, dims.width, dims.height);
      } else if (bgType === 'gradient') {
        const grad = ctx.createLinearGradient(0, 0, dims.width, dims.height);
        grad.addColorStop(0, '#0f172a');
        grad.addColorStop(0.5, '#1e1b4b');
        grad.addColorStop(1, '#31103f');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, dims.width, dims.height);
      } else if (bgType === 'blur' && images.length > 0) {
        ctx.save();
        ctx.filter = 'blur(40px) brightness(0.6)';
        ctx.drawImage(images[0], -50, -50, dims.width + 100, dims.height + 100);
        ctx.restore();
      }

      if (images.length === 0) return;

      // Set Shadow
      if (shadowIntensity > 0) {
        ctx.shadowColor = 'rgba(0, 0, 0, ' + (shadowIntensity / 100) + ')';
        ctx.shadowBlur = shadowIntensity * 0.5;
        ctx.shadowOffsetY = shadowIntensity * 0.3;
      } else {
        ctx.shadowColor = 'transparent';
      }

      // 2. Render Selected Layout
      const pad = gap;
      const r = radius;

      if (currentLayout === 'overlay') {
        // Layout 1: 2 Photos Overlaid (Background + Centered Foreground Overlay)
        const bgImg = images[0];
        const fgImg = images[1] || images[0];

        // Background Image
        drawImageCover(ctx, bgImg, pad, pad, dims.width - pad * 2, dims.height - pad * 2, r);

        // Overlay Centered Image (65% size)
        const overlayW = (dims.width - pad * 2) * 0.65;
        const overlayH = (dims.height - pad * 2) * 0.65;
        const overlayX = (dims.width - overlayW) / 2;
        const overlayY = (dims.height - overlayH) / 2;

        ctx.shadowColor = 'rgba(0, 0, 0, ' + (shadowIntensity / 70) + ')';
        ctx.shadowBlur = shadowIntensity * 0.8;
        drawImageCover(ctx, fgImg, overlayX, overlayY, overlayW, overlayH, r);
      } 
      else if (currentLayout === 'grid4') {
        // Layout 2: 4 Grid (2x2)
        const cellW = (dims.width - pad * 3) / 2;
        const cellH = (dims.height - pad * 3) / 2;

        const positions = [
          { x: pad, y: pad },
          { x: pad * 2 + cellW, y: pad },
          { x: pad, y: pad * 2 + cellH },
          { x: pad * 2 + cellW, y: pad * 2 + cellH }
        ];

        positions.forEach((pos, idx) => {
          const img = images[idx % images.length];
          drawImageCover(ctx, img, pos.x, pos.y, cellW, cellH, r);
        });
      }
      else if (currentLayout === 'vert10') {
        // Layout 3: 10 Vertical Strip (2 Columns x 5 Rows)
        const cols = 2;
        const rows = 5;
        const cellW = (dims.width - pad * (cols + 1)) / cols;
        const cellH = (dims.height - pad * (rows + 1)) / rows;

        for (let i = 0; i < 10; i++) {
          const c = i % cols;
          const rIdx = Math.floor(i / cols);
          const x = pad + c * (cellW + pad);
          const y = pad + rIdx * (cellH + pad);
          const img = images[i % images.length];
          drawImageCover(ctx, img, x, y, cellW, cellH, r);
        }
      }
      else if (currentLayout === 'horiz3') {
        // Layout 4: 3 Horizontal Grid Stack
        const rows = 3;
        const cellW = dims.width - pad * 2;
        const cellH = (dims.height - pad * 4) / rows;

        for (let i = 0; i < 3; i++) {
          const y = pad + i * (cellH + pad);
          const img = images[i % images.length];
          drawImageCover(ctx, img, pad, y, cellW, cellH, r);
        }
      }
      else if (currentLayout === 'polaroid') {
        // Layout 5: Polaroid Frame Style
        const frameW = dims.width - pad * 4;
        const frameH = dims.height - pad * 4;
        const frameX = pad * 2;
        const frameY = pad * 2;

        // White Frame Background
        ctx.save();
        ctx.fillStyle = '#ffffff';
        roundRect(ctx, frameX, frameY, frameW, frameH, r + 4);
        ctx.fill();
        ctx.restore();

        // Inner Photo
        const photoPad = 24;
        const photoW = frameW - photoPad * 2;
        const photoH = frameH - photoPad * 2 - 80; // Extra bottom space for polaroid caption
        drawImageCover(ctx, images[0], frameX + photoPad, frameY + photoPad, photoW, photoH, Math.max(0, r - 4));
      }
      else if (currentLayout === 'blurSingle') {
        // Layout 6: Single Focus with Blur BG
        const cellW = dims.width - pad * 4;
        const cellH = dims.height - pad * 4;
        drawImageCover(ctx, images[0], pad * 2, pad * 2, cellW, cellH, r);
      }

      // 3. Render Watermark Text if specified
      if (watermarkText.trim()) {
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.8)';
        ctx.shadowBlur = 6;
        ctx.fillStyle = '#ffffff';
        ctx.font = '600 24px Outfit, sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText(watermarkText, dims.width - pad - 20, dims.height - pad - 20);
        ctx.restore();
      }
    }

    // Event Listeners
    document.querySelectorAll('#layoutPresets .layout-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('#layoutPresets .layout-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentLayout = target.getAttribute('data-layout')!;
        drawCanvas();
      });
    });

    document.querySelectorAll('#ratioOptions .chip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('#ratioOptions .chip-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentRatio = target.getAttribute('data-ratio')!;
        drawCanvas();
      });
    });

    // File Upload Handler
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (!files || files.length === 0) return;

      const loadedImgs: HTMLImageElement[] = [];
      let count = 0;
      for (let i = 0; i < files.length; i++) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            loadedImgs.push(img);
            count++;
            if (count === files.length) {
              images = loadedImgs;
              renderSlots();
              drawCanvas();
            }
          };
          img.src = event.target!.result as string;
        };
        reader.readAsDataURL(files[i]);
      }
    });

    // Sample Load Button
    document.getElementById('btnLoadSamples')!.addEventListener('click', loadSamples);

    // Range Controls
    const gapRange = document.getElementById('gapRange') as HTMLInputElement;
    gapRange.addEventListener('input', (e) => {
      gap = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('gapVal')!.textContent = `${gap}px`;
      drawCanvas();
    });

    const radiusRange = document.getElementById('radiusRange') as HTMLInputElement;
    radiusRange.addEventListener('input', (e) => {
      radius = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('radiusVal')!.textContent = `${radius}px`;
      drawCanvas();
    });

    const shadowRange = document.getElementById('shadowRange') as HTMLInputElement;
    shadowRange.addEventListener('input', (e) => {
      shadowIntensity = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('shadowVal')!.textContent = `${shadowIntensity}%`;
      drawCanvas();
    });

    // Background type
    document.querySelectorAll('input[name="bgType"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        bgType = (e.target as HTMLInputElement).value;
        drawCanvas();
      });
    });

    const bgColorPicker = document.getElementById('bgColorPicker') as HTMLInputElement;
    bgColorPicker.addEventListener('input', (e) => {
      bgColor = (e.target as HTMLInputElement).value;
      bgType = 'color';
      drawCanvas();
    });

    // Filter
    const filterSelect = document.getElementById('filterSelect') as HTMLSelectElement;
    filterSelect.addEventListener('change', (e) => {
      currentFilter = (e.target as HTMLSelectElement).value;
      drawCanvas();
    });

    // Watermark
    const watermarkInput = document.getElementById('watermarkInput') as HTMLInputElement;
    watermarkInput.addEventListener('input', (e) => {
      watermarkText = (e.target as HTMLInputElement).value;
      drawCanvas();
    });

    // Actions
    document.getElementById('btnShuffle')!.addEventListener('click', () => {
      images.sort(() => Math.random() - 0.5);
      renderSlots();
      drawCanvas();
    });

    document.getElementById('btnReset')!.addEventListener('click', () => {
      gap = 20; radius = 16; shadowIntensity = 40;
      gapRange.value = '20'; document.getElementById('gapVal')!.textContent = '20px';
      radiusRange.value = '16'; document.getElementById('radiusVal')!.textContent = '16px';
      shadowRange.value = '40'; document.getElementById('shadowVal')!.textContent = '40%';
      currentFilter = 'none'; filterSelect.value = 'none';
      watermarkText = ''; watermarkInput.value = '';
      drawCanvas();
    });

    // One-Click HD Download
    document.getElementById('btnDownload')!.addEventListener('click', () => {
      const loader = document.getElementById('canvasLoader')!;
      loader.classList.remove('hidden');
      setTimeout(() => {
        const link = document.createElement('a');
        link.download = `PicGrid_${currentLayout}_${Date.now()}.png`;
        link.href = canvas.toDataURL('image/png', 1.0);
        link.click();
        loader.classList.add('hidden');
      }, 300);
    });

    // Initial Load
    loadSamples();
  });
</script>
