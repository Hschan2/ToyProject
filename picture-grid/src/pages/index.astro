---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LayoutSelector from '../components/sidebar/LayoutSelector.astro';
import ImageUploader from '../components/sidebar/ImageUploader.astro';
import StyleControls from '../components/sidebar/StyleControls.astro';
import StageToolbar from '../components/stage/StageToolbar.astro';
import CanvasViewport from '../components/stage/CanvasViewport.astro';
---

<Layout title="Picture Grid (픽그) - 원클릭 소셜미디어 사진 그리드 생성기">
  <div class="app-container">
    <!-- Header -->
    <Header />

    <!-- Main Workspace Grid -->
    <main class="workspace">
      <!-- Control Sidebar -->
      <aside class="sidebar glass-panel">
        <LayoutSelector />
        <ImageUploader />
        <StyleControls />
      </aside>

      <!-- Preview Canvas Stage -->
      <section class="stage-container">
        <StageToolbar />
        <CanvasViewport />
      </section>
    </main>
  </div>
</Layout>

<style>
  .app-container {
    height: 100vh;
    max-height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 10px;
    max-width: 1720px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Workspace Layout (Left: Config, Right: Preview) */
  .workspace {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 370px 1fr;
    gap: 12px;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .app-container {
      height: auto;
      overflow: auto;
    }
    .workspace {
      grid-template-columns: 1fr;
    }
  }

  /* Sidebar Controls */
  .sidebar {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: var(--radius-md);
    scrollbar-width: thin;
  }

  /* Stage Workspace (Right: Preview) */
  .stage-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    min-height: 0;
  }
</style>

<script>
  import { initApp } from '../core/app';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
  } else {
    initApp();
  }
</script>
