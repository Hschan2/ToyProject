---
// Step 1: Layout Selection Component
const layouts = [
  { id: 'overlay', name: '2장 겹침', iconClass: 'icon-overlay', title: '2장 겹침 (오버레이)', active: true },
  { id: 'grid4', name: '4개 그리드', iconClass: 'icon-grid4', title: '4개 그리드 (2x2)', active: false },
  { id: 'vert10', name: '10개 세로', iconClass: 'icon-vert10', title: '10개 세로 스트립', active: false },
  { id: 'horiz3', name: '3개 가로', iconClass: 'icon-horiz3', title: '3개 가로 그리드', active: false },
  { id: 'polaroid', name: '폴라로이드', iconClass: 'icon-polaroid', title: '폴라로이드 프레임', active: false },
  { id: 'blurSingle', name: '블러 배경', iconClass: 'icon-blurSingle', title: '블러 배경 모드', active: false },
  { id: 'splitInvert', name: '반전 분할', iconClass: 'icon-splitInvert', title: '반전 분할 (2장 교차 오버레이)', active: false },
];
---

<section class="control-section">
  <h3><span class="step-num">1</span> 그리드 레이아웃 선택</h3>
  <div class="layout-presets" id="layoutPresets">
    {layouts.map((item) => (
      <button
        class={`layout-btn ${item.active ? 'active' : ''}`}
        data-layout={item.id}
        title={item.title}
      >
        <div class={`layout-icon ${item.iconClass}`}></div>
        <span>{item.name}</span>
      </button>
    ))}
  </div>
</section>

<style>
  .control-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 10px;
  }

  .control-section h3 {
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-main);
  }

  .step-num {
    background: var(--accent-gradient);
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .layout-presets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .layout-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 500;
    transition: all 0.18s ease;
  }
  .layout-btn span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .layout-btn:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: var(--accent-purple);
    color: var(--text-main);
  }
  .layout-btn:hover .layout-icon {
    border-color: var(--accent-purple);
  }
  .layout-btn.active {
    background: rgba(99, 102, 241, 0.15);
    border-color: var(--accent-purple);
    color: #fff;
    box-shadow: 0 0 12px rgba(139, 92, 246, 0.25);
  }

  /* Layout Icons */
  .layout-icon {
    width: 32px;
    height: 24px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    position: relative;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    transition: border-color 0.2s ease;
  }

  .icon-overlay::before {
    content: '';
    position: absolute;
    inset: 3px;
    background: rgba(99, 102, 241, 0.4);
    border-radius: 2px;
  }
  .icon-overlay::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 13px;
    top: 6px;
    left: 8px;
    background: #ec4899;
    border-radius: 2px;
    border: 1px solid #fff;
  }

  .icon-grid4 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 3px;
  }
  .icon-grid4::before,
  .icon-grid4::after {
    content: '';
    background: rgba(99, 102, 241, 0.6);
    border-radius: 1px;
  }

  .icon-vert10 {
    display: flex;
    gap: 1px;
    padding: 3px;
    overflow: hidden;
  }
  .icon-vert10::before {
    content: '';
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      90deg,
      #6366f1 0px,
      #6366f1 2px,
      #a855f7 2px,
      #a855f7 4px,
      #ec4899 4px,
      #ec4899 6px,
      #06b6d4 6px,
      #06b6d4 8px
    );
    border-radius: 1px;
  }

  .icon-horiz3 {
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    padding: 3px;
  }
  .icon-horiz3::before {
    content: '';
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      180deg,
      #8b5cf6 0px,
      #8b5cf6 4px,
      transparent 4px,
      transparent 6px
    );
    border-radius: 1px;
  }

  .icon-polaroid {
    padding: 2px 2px 5px 2px;
    background: #fff;
    border-radius: 2px;
  }
  .icon-polaroid::before {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    background: #6366f1;
    border-radius: 1px;
  }

  .icon-blurSingle {
    background: radial-gradient(circle, #ec4899 0%, #0f172a 100%);
  }
  .icon-blurSingle::after {
    content: '';
    position: absolute;
    inset: 4px;
    background: #6366f1;
    border-radius: 2px;
  }

  .icon-splitInvert {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, #f97316 50%, #0284c7 50%);
  }
  .icon-splitInvert::before {
    content: '';
    position: absolute;
    inset: 4px 7px;
    background: linear-gradient(90deg, #0284c7 50%, #f97316 50%);
    border-radius: 1px;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
</style>
