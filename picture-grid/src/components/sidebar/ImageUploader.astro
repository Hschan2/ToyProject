---
// Step 2: Image Uploader Component
---

<section class="control-section">
  <div class="section-header-flex">
    <h3><span class="step-num">2</span> 사진 업로드</h3>
    <button id="btnLoadSamples" class="btn-text-action">✨ 샘플 불러오기</button>
  </div>

  <div class="upload-dropzone" id="dropzone">
    <input type="file" id="fileInput" multiple accept="image/*" class="file-input-hidden" />
    <div class="dropzone-content">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="17 8 12 3 7 8" />
        <line x1="12" y1="3" x2="12" y2="15" />
      </svg>
      <p>사진 드래그 또는 클릭 업로드</p>
      <span class="help-text">PNG, JPG, WEBP 다중 지원</span>
    </div>
  </div>

  <!-- Dynamic Image Thumbnails Slot Bar -->
  <div class="slots-container" id="slotsContainer"></div>
</section>

<style>
  .control-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 10px;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .control-section h3 {
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-main);
  }

  .step-num {
    background: var(--accent-gradient);
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .btn-text-action {
    background: none;
    border: none;
    color: var(--accent-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .btn-text-action:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .upload-dropzone {
    border: 1.5px dashed rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    text-align: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s ease;
    position: relative;
  }
  .upload-dropzone:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: var(--accent-purple);
    box-shadow: 0 0 16px rgba(139, 92, 246, 0.15);
  }
  .upload-dropzone:hover .dropzone-content svg {
    color: var(--accent-purple);
    stroke: var(--accent-purple);
    transform: translateY(-1px);
  }

  .file-input-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: var(--text-muted);
  }
  .dropzone-content svg {
    color: var(--text-dim);
    transition: all 0.2s ease;
  }
  .dropzone-content p {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .help-text {
    font-size: 0.68rem;
    color: var(--text-dim);
  }

  .slots-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px 0 2px 0;
    max-height: 115px;
    overflow-y: auto;
  }

  :global(.slot-thumb) {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  :global(.slot-thumb:hover) {
    transform: scale(1.05);
    border-color: var(--accent-purple);
  }
</style>
