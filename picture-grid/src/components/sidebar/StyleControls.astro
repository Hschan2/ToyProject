---
// Step 3: Style Adjustments Component
const ratios = [
  { id: '1:1', label: '1:1 (정사각)', active: true },
  { id: '4:5', label: '4:5 (피드)', active: false },
  { id: '9:16', label: '9:16 (스토리)', active: false },
  { id: '16:9', label: '16:9 (와이드)', active: false },
];
---

<section class="control-section">
  <h3><span class="step-num">3</span> 커스텀 디자인 설정</h3>

  <!-- Aspect Ratio -->
  <div class="control-group">
    <label>화면 비율</label>
    <div class="ratio-options" id="ratioOptions">
      {ratios.map((item) => (
        <button
          class={`chip-btn ${item.active ? 'active' : ''}`}
          data-ratio={item.id}
        >
          {item.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Gap and Radius Sliders -->
  <div class="sliders-grid">
    <div class="control-group">
      <div class="slider-header">
        <label>여백</label>
        <span class="val-display" id="gapVal">20px</span>
      </div>
      <input type="range" id="gapRange" min="0" max="60" value="20" />
    </div>

    <div class="control-group">
      <div class="slider-header">
        <label>모서리 둥글기</label>
        <span class="val-display" id="radiusVal">16px</span>
      </div>
      <input type="range" id="radiusRange" min="0" max="50" value="16" />
    </div>
  </div>

  <!-- Shadow Slider -->
  <div class="control-group">
    <div class="slider-header">
      <label>그림자 강도</label>
      <span class="val-display" id="shadowVal">40%</span>
    </div>
    <input type="range" id="shadowRange" min="0" max="100" value="40" />
  </div>

  <!-- Background Options -->
  <div class="control-group">
    <label>배경 스타일</label>
    <div class="bg-style-picker">
      <label class="bg-option">
        <input type="radio" name="bgType" value="color" checked />
        <span>단색</span>
        <input type="color" id="bgColorPicker" value="#0f172a" />
      </label>
      <label class="bg-option">
        <input type="radio" name="bgType" value="gradient" />
        <span>그라디언트</span>
      </label>
      <label class="bg-option">
        <input type="radio" name="bgType" value="blur" />
        <span>블러</span>
      </label>
    </div>
  </div>

  <!-- Photo Filters -->
  <div class="control-group">
    <label>사진 필터</label>
    <select id="filterSelect" class="styled-select">
      <option value="none">원본 (None)</option>
      <optgroup label="🎞️ 아날로그 필름 효과 (노이즈+비네팅)">
        <option value="kodak">🎞️ 코닥 웜 골드 (Kodak 35mm)</option>
        <option value="fuji">🎞️ 후지 클래식 (Fuji Chrome)</option>
        <option value="vintage">🎞️ 빈티지 80s (Vintage Film)</option>
        <option value="noir">🎞️ 필름 누아르 (B&W Tri-X)</option>
        <option value="cinematic">🎞️ 시네마틱 틸&오렌지 (Cinematic)</option>
      </optgroup>
      <optgroup label="🎨 일반 감성 필터">
        <option value="warm">감성 워머 (Warm Vintage)</option>
        <option value="cool">쿨 사이버 (Cool Blue)</option>
        <option value="bw">클래식 흑백 (Monochrome)</option>
        <option value="vivid">비비드 팝 (High Contrast)</option>
        <option value="soft">파스텔 소프트 (Soft Glow)</option>
      </optgroup>
    </select>
  </div>

  <!-- Date Stamp Checkbox -->
  <div class="control-group">
    <label class="checkbox-container">
      <input type="checkbox" id="dateStampCheckbox" />
      <span class="checkbox-label">📅 필름 카메라 날짜 스탬프 ('26 09 04)</span>
    </label>
  </div>

  <!-- Watermark Input -->
  <div class="control-group">
    <label>워터마크 / 서명 텍스트</label>
    <input type="text" id="watermarkInput" placeholder="예: @my_instagram" class="styled-input" />
  </div>
</section>

<style>
  .control-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: none;
    padding-bottom: 0;
  }

  .control-section h3 {
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-main);
  }

  .step-num {
    background: var(--accent-gradient);
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .control-group label {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .sliders-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .val-display {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .ratio-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .chip-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    padding: 5px 2px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    transition: all 0.18s ease;
  }
  .chip-btn:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: var(--accent-purple);
    color: #fff;
  }
  .chip-btn.active {
    background: rgba(139, 92, 246, 0.25);
    color: #fff;
    border-color: var(--accent-purple);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.25);
  }

  .bg-style-picker {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .bg-option {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.76rem;
    cursor: pointer;
  }
  .bg-option input[type="radio"] {
    cursor: pointer;
    accent-color: #8b5cf6;
  }
  .bg-option input[type="color"] {
    width: 22px;
    height: 22px;
  }

  .styled-select,
  .styled-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-main);
    padding: 7px 10px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.78rem;
    outline: none;
    color-scheme: dark;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .styled-select:hover,
  .styled-input:hover {
    border-color: rgba(139, 92, 246, 0.6);
  }
  .styled-select:focus,
  .styled-input:focus {
    border-color: var(--accent-purple);
    box-shadow: 0 0 8px rgba(139, 92, 246, 0.25);
  }
  .styled-select optgroup {
    background-color: #1e1b4b;
    color: #38bdf8;
    font-weight: 700;
    font-style: normal;
    padding: 4px;
  }
  .styled-select option {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 4px 8px;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.03);
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }
  .checkbox-container:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.3);
  }
  .checkbox-container input[type="checkbox"] {
    cursor: pointer;
    accent-color: #f59e0b;
    width: 15px;
    height: 15px;
  }
  .checkbox-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }
</style>
